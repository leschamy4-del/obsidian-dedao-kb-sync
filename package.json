{
  "name": "obsidian-dedao-kb-sync",
  "version": "1.0.3",
  "description": "得到大脑知识库同步：按知识库自动建文件夹并打标签，同步得到大脑与订阅的抖音博主内容到 Obsidian。衍生自 AndyZhengyan/obsidian-dedao-brain-sync（MIT）。",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:e2e:openapi": "vitest run tests/openapi-knowledge-sync.e2e.spec.ts",
    "smoke:getnote": "node scripts/smoke-getnote-api.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "dedao",
    "getnote",
    "knowledge-base"
  ],
  "author": "Marvincao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leschamy4-del/obsidian-dedao-kb-sync.git"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "preact": "^10.29.7",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  }
}
